# Copia este archivo como .env si quieres cambiar algo. Todas las variables son opcionales.
# EduMap lee este archivo al arrancar el backend. Si una variable ya existe en el sistema, esa gana.
# Los valores mostrados son los predeterminados.

# Carpeta donde se guardan la base SQLite y los PDF subidos
EDUMAP_DATA_DIR=./data

# Límites
EDUMAP_MAX_UPLOAD_MB=25
EDUMAP_MAX_PAGES=300
EDUMAP_MAX_OCR_PAGES=40

# Idiomas de Tesseract (separados por +). Si "spa" no está instalado se usa "eng" y se avisa.
EDUMAP_OCR_LANGS=spa+eng

# Ruta del ejecutable de Tesseract (solo si no está en el PATH). Ejemplo en Windows:
# EDUMAP_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Orígenes permitidos por CORS (el frontend de Vite en desarrollo)
EDUMAP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
